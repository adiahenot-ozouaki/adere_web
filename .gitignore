```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.out/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.*
!.env.example

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Cache
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache

# TypeScript
*.tsbuildinfo

# Testing
playwright-report/
test-results/

# Temporary files
tmp/
temp/

# Local package managers
.pnpm-store/
.npm/

# Optional lockfiles (gardez uniquement celui que vous utilisez)
yarn.lock
# package-lock.json
# pnpm-lock.yaml
```
